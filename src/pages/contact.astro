---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import { SITE } from '../data/site';
import { PROCESS, SKILLS } from '../data/profile';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.jins.mokc.top/' },
    { '@type': 'ListItem', position: 2, name: '联系我', item: 'https://www.jins.mokc.top/contact' },
  ],
};
---

<BaseLayout
  title="联系我"
  description="B2B 数字营销、独立站搭建、广告投放与 AI 提效项目合作。邮件联系或直接聊，先说清情况再判断能不能帮上。"
  structuredData={[breadcrumb]}
>
  <section class="page-head">
    <div class="container">
      <SectionHeading
        as="h1"
        eyebrow="联系我"
        title="先说情况，再谈合作"
        lead="邮件或直接联系都可以。说清楚现在的渠道、遇到的问题、期望的结果，我再判断能不能帮上。帮不上会直接告诉你。"
      />
    </div>
  </section>

  <section class="section">
    <div class="container contact">
      <div class="contact__main">
        <h2 class="contact__h2">联系方式</h2>

        <ul class="channels">
          <li class="channel">
            <p class="channel__label mono">Email</p>
            <a class="channel__value" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <p class="channel__hint">工作日 24 小时内回复</p>
          </li>
          <li class="channel">
            <p class="channel__label mono">博客</p>
            <a
              class="channel__value"
              href="https://www.jins.top"
              target="_blank"
              rel="noopener noreferrer">www.jins.top ↗</a
            >
            <p class="channel__hint">看实战笔记，判断专业度</p>
          </li>
        </ul>

        <h2 class="contact__h2">聊之前，建议先想清楚三件事</h2>
        <ol class="prep">
          <li>
            <strong>现在怎么获客？</strong>
            <span>平台、独立站、社媒、广告分别投了多少，效果如何，有没有数据。</span>
          </li>
          <li>
            <strong>卡在哪一步？</strong>
            <span>没流量、有流量没询盘、有询盘不成交。三个阶段的解法完全不同。</span>
          </li>
          <li>
            <strong>期望和预算是多少？</strong>
            <span>目标市场、期望线索量、可投入的预算和时间。不合理我也会直说。</span>
          </li>
        </ol>

        <div class="contact__action">
          <Button href={`mailto:${SITE.email}?subject=数字营销咨询`} size="lg">
            发邮件给我
          </Button>
          <Button href="/services" variant="secondary" size="lg">先看服务范围</Button>
        </div>
      </div>

      <aside class="contact__side">
        <div class="side-card">
          <p class="mono side-card__label">合作流程</p>
          <ol class="side-card__flow">
            {
              PROCESS.map((p) => (
                <li>
                  <span class="mono">{p.step}</span>
                  <div>
                    <strong>{p.title}</strong>
                    <p>{p.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="side-card">
          <p class="mono side-card__label">擅长方向</p>
          <ul class="side-card__skills">
            {
              SKILLS.map((s) => (
                <li>
                  <span class="mono">{s.no}</span>
                  {s.title}
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(3rem, 7vw, var(--sp-8)) var(--sp-7);
    background: var(--c-bg-soft);
    border-bottom: 1px solid var(--c-line-soft);
  }

  .page-head :global(.sec-head) {
    margin-bottom: 0;
  }

  .contact {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, var(--sp-8));
    align-items: start;
  }

  .contact__h2 {
    font-size: var(--fs-xl);
    margin-bottom: var(--sp-5);
  }

  .contact__main .contact__h2:not(:first-child) {
    margin-top: var(--sp-8);
  }

  /* 渠道 */
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--sp-4);
  }

  .channel {
    padding: var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur) var(--ease);
  }

  .channel:hover {
    border-color: var(--c-accent);
  }

  .channel__label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-subtle);
    margin-bottom: var(--sp-3);
  }

  .channel__value {
    display: block;
    font-size: var(--fs-md);
    font-weight: 650;
    color: var(--c-ink);
    word-break: break-all;
  }

  .channel__value:hover {
    color: var(--c-accent);
  }

  .channel__hint {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  /* 准备事项 */
  .prep {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .prep li {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-bg-soft);
    border-left: 3px solid var(--c-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .prep strong {
    color: var(--c-ink);
  }

  .prep span {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .contact__action {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-7);
  }

  /* 侧栏 */
  .contact__side {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .side-card {
    padding: var(--sp-5);
    background: var(--c-bg-soft);
    border: 1px solid var(--c-line-soft);
    border-radius: var(--radius-lg);
  }

  .side-card__label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-subtle);
    margin-bottom: var(--sp-4);
  }

  .side-card__flow {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .side-card__flow li {
    display: flex;
    gap: var(--sp-3);
  }

  .side-card__flow .mono {
    flex-shrink: 0;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-accent);
    padding-top: 0.15em;
  }

  .side-card__flow strong {
    display: block;
    font-size: var(--fs-base);
    color: var(--c-ink);
  }

  .side-card__flow p {
    margin-top: var(--sp-1);
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--c-muted);
  }

  .side-card__skills {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .side-card__skills li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--fs-base);
    color: var(--c-ink-2);
  }

  .side-card__skills .mono {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-accent);
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
