---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import { SITE } from '../data/site';
import { PROCESS, SKILLS } from '../data/profile';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.jins.mokc.top/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://www.jins.mokc.top/contact' },
  ],
};
---

<BaseLayout
  title="Contact"
  description="Send a heat treatment furnace enquiry — include the part, the process, the throughput target and the site utilities so we can reply with a relevant answer."
  structuredData={[breadcrumb]}
>
  <section class="page-head">
    <div class="container">
      <SectionHeading
        as="h1"
        eyebrow="Contact"
        title="Tell us about the process"
        lead="The more specific the enquiry, the more useful the reply. Part, process, throughput and utilities get you a real answer rather than a brochure."
      />
    </div>
  </section>

  <section class="section">
    <div class="container contact">
      <div class="contact__main">
        <h2 class="contact__h2">Contact</h2>

        <ul class="channels">
          <li class="channel">
            <p class="channel__label mono">Email</p>
            <a class="channel__value" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <p class="channel__hint">Replies within one working day</p>
          </li>
          <li class="channel">
            <p class="channel__label mono">Technical library</p>
            <a class="channel__value" href="/notes">Articles</a>
            <p class="channel__hint">Furnace selection, atmosphere and uniformity notes</p>
          </li>
        </ul>

        <h2 class="contact__h2">Useful to include in your enquiry</h2>
        <ol class="prep">
          <li>
            <strong>What is the part?</strong>
            <span>Material, dimensions, weight, and how it is loaded — single piece, basket or fixture.</span>
          </li>
          <li>
            <strong>What is the process?</strong>
            <span>Harden and temper, anneal, normalise, stress relieve, sinter, solution treat — and the atmosphere required.</span>
          </li>
          <li>
            <strong>What is the throughput?</strong>
            <span>Target output per hour or per day, working hours per day, and how many operators will run it.</span>
          </li>
          <li>
            <strong>What is the site situation?</strong>
            <span>Available footprint, utilities — gas, electricity, compressed air — and any existing handling equipment.</span>
          </li>
        </ol>

        <div class="contact__action">
          <Button href={`mailto:${SITE.email}?subject=Heat treatment furnace enquiry`} size="lg">
            Email us
          </Button>
          <Button href="/products" variant="secondary" size="lg">View furnaces</Button>
        </div>
      </div>

      <aside class="contact__side">
        <div class="side-card">
          <p class="mono side-card__label">Delivery process</p>
          <ol class="side-card__flow">
            {
              PROCESS.map((p) => (
                <li>
                  <span class="mono">{p.step}</span>
                  <div>
                    <strong>{p.title}</strong>
                    <p>{p.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="side-card">
          <p class="mono side-card__label">Product range</p>
          <ul class="side-card__skills">
            {
              SKILLS.map((s) => (
                <li>
                  <span class="mono">{s.no}</span>
                  {s.title}
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(3rem, 7vw, var(--sp-8)) var(--sp-7);
    background: var(--c-bg-soft);
    border-bottom: 1px solid var(--c-line-soft);
  }

  .page-head :global(.sec-head) {
    margin-bottom: 0;
  }

  .contact {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, var(--sp-8));
    align-items: start;
  }

  .contact__h2 {
    font-size: var(--fs-xl);
    margin-bottom: var(--sp-5);
  }

  .contact__main .contact__h2:not(:first-child) {
    margin-top: var(--sp-8);
  }

  /* 渠道 */
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--sp-4);
  }

  .channel {
    padding: var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur) var(--ease);
  }

  .channel:hover {
    border-color: var(--c-accent);
  }

  .channel__label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-subtle);
    margin-bottom: var(--sp-3);
  }

  .channel__value {
    display: block;
    font-size: var(--fs-md);
    font-weight: 650;
    color: var(--c-ink);
    word-break: break-all;
  }

  .channel__value:hover {
    color: var(--c-accent);
  }

  .channel__hint {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  /* 准备事项 */
  .prep {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .prep li {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-bg-soft);
    border-left: 3px solid var(--c-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .prep strong {
    color: var(--c-ink);
  }

  .prep span {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .contact__action {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-7);
  }

  /* 侧栏 */
  .contact__side {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .side-card {
    padding: var(--sp-5);
    background: var(--c-bg-soft);
    border: 1px solid var(--c-line-soft);
    border-radius: var(--radius-lg);
  }

  .side-card__label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-subtle);
    margin-bottom: var(--sp-4);
  }

  .side-card__flow {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .side-card__flow li {
    display: flex;
    gap: var(--sp-3);
  }

  .side-card__flow .mono {
    flex-shrink: 0;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-accent);
    padding-top: 0.15em;
  }

  .side-card__flow strong {
    display: block;
    font-size: var(--fs-base);
    color: var(--c-ink);
  }

  .side-card__flow p {
    margin-top: var(--sp-1);
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--c-muted);
  }

  .side-card__skills {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .side-card__skills li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--fs-base);
    color: var(--c-ink-2);
  }

  .side-card__skills .mono {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-accent);
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
