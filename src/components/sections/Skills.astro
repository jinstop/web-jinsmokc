---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import { SKILLS } from '../../data/profile';
---

<section class="section section--soft" id="skills">
  <div class="container">
    <SectionHeading
      eyebrow="Product range"
      title="Four continuous furnace platforms"
      lead="The platform follows the part, the weight and the throughput. Most lines combine one primary type with a quench or cooling section."
    />

    <div class="skills__grid">
      {
        SKILLS.map((s) => (
          <Card
            no={s.no}
            title={s.title}
            description={s.body}
            tags={s.tags}
            points={[...s.points]}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-4);
  }
</style>
