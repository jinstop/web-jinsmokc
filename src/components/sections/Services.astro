---
import SectionHeading from '../ui/SectionHeading.astro';
import { SERVICES, PROCESS } from '../../data/profile';
---

<section class="section section--soft" id="services">
  <div class="container">
    <SectionHeading
      eyebrow="服务"
      title="能落地的数字营销方案"
      lead="每项服务都写清楚交付物。做不到的不写，写了就一定交得出来。"
    />

    <div class="svc__grid">
      {
        SERVICES.map((s) => (
          <article class="svc">
            <p class="svc__no mono">{s.no}</p>
            <h3 class="svc__title">{s.title}</h3>
            <p class="svc__summary">{s.summary}</p>
            <p class="svc__body">{s.body}</p>
            <div class="svc__deliver">
              <p class="svc__deliver-label mono">交付物</p>
              <ul>
                {s.deliverables.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section" id="process">
  <div class="container">
    <SectionHeading
      eyebrow="合作流程"
      title="四步，从诊断到复盘"
      lead="不搞黑盒交付。每一步都有明确的产出和判断依据。"
    />

    <ol class="proc">
      {
        PROCESS.map((p) => (
          <li class="proc__step">
            <span class="proc__no mono">{p.step}</span>
            <h3 class="proc__title">{p.title}</h3>
            <p class="proc__body">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .svc__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--sp-4);
  }

  .svc {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-6) var(--sp-5) var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .svc:hover {
    border-color: var(--c-ink);
    box-shadow: var(--shadow);
  }

  .svc__no {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--c-accent);
  }

  .svc__title {
    font-size: var(--fs-lg);
  }

  .svc__summary {
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--c-ink-2);
  }

  .svc__body {
    font-size: var(--fs-base);
    line-height: 1.75;
    color: var(--c-muted);
  }

  .svc__deliver {
    margin-top: auto;
    padding-top: var(--sp-4);
    border-top: 1px dashed var(--c-line);
  }

  .svc__deliver-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-subtle);
    margin-bottom: var(--sp-3);
  }

  .svc__deliver ul {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .svc__deliver li {
    position: relative;
    padding-left: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--c-body);
  }

  .svc__deliver li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--c-accent);
    font-weight: 700;
  }

  /* 流程 */
  .proc {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-5);
    counter-reset: proc;
  }

  .proc__step {
    position: relative;
    padding: var(--sp-5);
    background: var(--c-bg-soft);
    border-radius: var(--radius-lg);
    border: 1px solid var(--c-line-soft);
  }

  .proc__no {
    display: inline-block;
    font-size: var(--fs-2xl);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--c-line);
  }

  .proc__title {
    margin-top: var(--sp-3);
    font-size: var(--fs-lg);
  }

  .proc__body {
    margin-top: var(--sp-3);
    font-size: var(--fs-base);
    line-height: 1.75;
    color: var(--c-muted);
  }
</style>
